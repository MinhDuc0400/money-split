{
  "expo": {
    "name": "Split Money",
    "slug": "money-split-mobile",
    "scheme": "money-split",
    "version": "1.0.0",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": { "backgroundColor": "#3D5AFE" },
    "ios": { "supportsTablet": false, "bundleIdentifier": "com.ducnguyen.splitmoney" },
    "android": { "package": "com.ducnguyen.splitmoney", "adaptiveIcon": { "backgroundColor": "#3D5AFE" }, "intentFilters": [{ "action": "VIEW", "autoVerify": true, "data": [{ "scheme": "money-split" }], "category": ["BROWSABLE", "DEFAULT"] }] },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": { "typedRoutes": true }
  }
}
