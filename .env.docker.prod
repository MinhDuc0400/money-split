# ── Docker Production Environment ────────────────────────────────────────────
# Used with:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.docker.prod up -d --build
#
# IMPORTANT: Replace every placeholder value before deploying.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=splitmoney

# ── NestJS backend ────────────────────────────────────────────────────────────
NODE_ENV=production
JWT_SECRET=change-me-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d

# Google OAuth – must match the authorized redirect URI in Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://your-domain.com/api/auth/google/callback

# CORS – must match the public URL of the frontend
FRONTEND_URL=https://your-domain.com

# ── Vite frontend (embedded at build time) ────────────────────────────────────
# All traffic goes through the nginx entry point on port 80.
# /api/* is proxied to the backend by nginx, so the browser calls the same origin.
VITE_API_URL=https://your-domain.com/api
VITE_API_PUBLIC_URL=https://your-domain.com/api
