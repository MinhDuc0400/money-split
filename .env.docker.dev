# ── Docker Development Environment ───────────────────────────────────────────
# Used with:
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml --env-file .env.docker.dev up

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=splitmoney

# ── NestJS backend ────────────────────────────────────────────────────────────
NODE_ENV=development
JWT_SECRET=dev-jwt-secret-change-me
JWT_EXPIRES_IN=7d

# Google OAuth – use your real credentials or a dev-only OAuth app
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Callback hits the backend container directly in dev
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# CORS – allow the Vite dev server
FRONTEND_URL=http://localhost:5173

# ── Vite frontend ─────────────────────────────────────────────────────────────
# Browser-side URLs – must be reachable from the host machine browser
VITE_API_URL=http://localhost:3000
VITE_API_PUBLIC_URL=http://localhost:3000
